# API key configured in the oMLX app (Settings -> API)
OMLX_API_KEY=

# Where the oMLX server listens. Used by native runs; docker-compose
# overrides it with http://host.docker.internal:8000/v1.
OMLX_API_BASE=http://127.0.0.1:8000/v1

# Key clients must send to this proxy (Authorization: Bearer <key>)
# Also the Admin UI password (username: admin)
LITELLM_MASTER_KEY=sk-change-me

# Postgres for the Admin UI / virtual keys. DATABASE_URL is for native runs;
# docker-compose points the container at the postgres service instead.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://litellm:change-me@127.0.0.1:5432/litellm

# Resend email integration (user invites, key-created and budget alerts).
# Leave RESEND_API_KEY empty to disable; the proxy starts fine without it.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Vercel AI Gateway (https://vercel.com/ai-gateway). Used by smart_router_hybrid
# for its Jev classifier (jev-classifier) and COMPLEX tier
# (vercel-deepseek-v4.1-flash). Empty: those two models fail, and the hybrid
# router's classifier falls back to litellm's local heuristic.
AI_GATEWAY_API_KEY=

# Base URL override. LEAVE THIS UNSET unless the proxy sits behind a stable
# public hostname or reverse proxy.
#
# It is a single global value that pins the Admin UI's API base. Set it, and the
# UI works only at that exact address - open the proxy at any other address
# (localhost, the LAN IP, an *.orb.local domain) and the page loads but every
# data call goes to the pinned host, so the UI renders empty. A DHCP lease
# change has the same effect, silently.
#
# Unset, the UI uses whatever origin you loaded it from, so all addresses work
# at once. Emailed invite/alert links then use the base URL of the request that
# created them - so send invites from an address the recipient can reach.
# PROXY_BASE_URL=https://litellm.example.com
